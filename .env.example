# ─────────────────────────────────────────────────────────────
# LINE message archive — environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (public — safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only — NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# LINE Messaging API (server-only)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Background job authentication (server-only)
# Guards /api/internal/retrieve-attachments.
# Generate with: openssl rand -hex 32
INTERNAL_JOB_SECRET=

# Monitoring (optional)
SENTRY_DSN=
